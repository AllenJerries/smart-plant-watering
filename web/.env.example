# -----------------------------------------------------------------------------
# Supabase
# Project Settings -> API. The URL and anon key are safe to expose to the
# browser; the service role key is server-only and must never be prefixed with
# NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required by /api/reading to insert telemetry and update alert state.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Device ingest
# Use a long random string, e.g. `openssl rand -hex 32`.
# Must match API_KEY in firmware/src/main.cpp.
# -----------------------------------------------------------------------------
ESP32_SECRET_KEY=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Telegram
# Create a bot with @BotFather, send it a message, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExampleToken
TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Dashboard
# Device id shown on the dashboard. Must match DEVICE_ID in the firmware.
# -----------------------------------------------------------------------------
PLANT_DEVICE_ID=plant-01
